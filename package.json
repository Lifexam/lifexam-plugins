{
  "name": "lifexam-plugins",
  "version": "1.0.4",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "plugins:build": "tsx scripts/build-plugins.ts",
    "plugins:check": "tsx scripts/build-plugins.ts --check",
